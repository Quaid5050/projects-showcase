# Backend API base URL (no trailing /health)
# Production (Vercel):
EXPO_PUBLIC_API_URL=https://pharmacy-backend-rouge.vercel.app/api
# Local dev on physical device — use your LAN IP instead of localhost:
# EXPO_PUBLIC_API_URL=http://192.168.1.21:5000/api

# Google Maps API key (for react-native-maps on Android)
EXPO_PUBLIC_GOOGLE_MAPS_KEY=your_google_maps_api_key_here

{
  "expo": {
    "name": "PharmaDeliver",
    "slug": "pharmacy-delivery",
    "version": "1.0.0",
    "scheme": "pharmacydelivery",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B1F3A"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.pharmacydelivery.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "We need your location to track deliveries.",
        "NSCameraUsageDescription": "Camera is used to capture proof of delivery.",
        "NSPhotoLibraryUsageDescription": "Photo library access is used to upload proof of delivery."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B1F3A"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.pharmacydelivery.app",
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow PharmaDeliver to use your location."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow PharmaDeliver to access the camera for proof of delivery."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow PharmaDeliver to access photos for proof of delivery."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4f8a0551-72d2-4615-adc7-93f0af18046c"
      }
    },
    "owner": "shuisme"
  }
}

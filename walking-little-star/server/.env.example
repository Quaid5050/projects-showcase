# ─── Gmail SMTP Configuration ─────────────────────────────────────────────────
# Use your Gmail address
GMAIL_USER=walkinglittlestar@gmail.com

# Generate a Gmail App Password (NOT your regular Gmail password):
# 1. Go to https://myaccount.google.com/security
# 2. Enable 2-Step Verification (required)
# 3. Go to https://myaccount.google.com/apppasswords
# 4. Select app: "Mail", device: "Other" → type "Walking Little Star Website"
# 5. Copy the 16-character password shown and paste it below
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# ─── Server Configuration ─────────────────────────────────────────────────────
PORT=3001

# ─── CORS Origin ──────────────────────────────────────────────────────────────
# Development: http://localhost:5173
# Production: https://walkinglittlestardaycare.com
CORS_ORIGIN=http://localhost:5173

# ─── Email Recipients ─────────────────────────────────────────────────────────
# Email address that receives all form submissions
RECIPIENT_EMAIL=walkinglittlestar@gmail.com

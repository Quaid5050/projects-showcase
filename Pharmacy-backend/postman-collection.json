{
  "info": {
    "name": "PharmaDeliver API",
    "description": "Complete API collection for the Pharmacy Delivery Management System",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:5000/api", "type": "string" },
    { "key": "token", "value": "", "type": "string" },
    { "key": "admin_token", "value": "", "type": "string" },
    { "key": "driver_token", "value": "", "type": "string" },
    { "key": "order_id", "value": "", "type": "string" },
    { "key": "driver_id", "value": "", "type": "string" },
    { "key": "patient_id", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/health"
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login (Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var res = pm.response.json();",
                  "if (res.data && res.data.token) {",
                  "  pm.collectionVariables.set('admin_token', res.data.token);",
                  "  pm.collectionVariables.set('token', res.data.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@demopharmacy.com\",\n  \"password\": \"Admin123!\"\n}"
            },
            "url": "{{base_url}}/auth/login"
          }
        },
        {
          "name": "Login (Driver)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var res = pm.response.json();",
                  "if (res.data && res.data.token) {",
                  "  pm.collectionVariables.set('driver_token', res.data.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"driver@demopharmacy.com\",\n  \"password\": \"Driver123!\"\n}"
            },
            "url": "{{base_url}}/auth/login"
          }
        },
        {
          "name": "Get Me",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/auth/me"
          }
        },
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"New Staff\",\n  \"email\": \"staff@demopharmacy.com\",\n  \"phone\": \"+1555000001\",\n  \"password\": \"Staff123!\",\n  \"role\": \"staff\"\n}"
            },
            "url": "{{base_url}}/auth/register"
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/auth/logout"
          }
        }
      ]
    },
    {
      "name": "Orders",
      "item": [
        {
          "name": "List Orders",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{base_url}}/orders?page=1&limit=20",
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" },
                { "key": "status", "value": "pending", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Create Order",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var res = pm.response.json();",
                  "if (res.data && res.data.order) {",
                  "  pm.collectionVariables.set('order_id', res.data.order._id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"patient\": {\n    \"name\": \"Jane Smith\",\n    \"phone\": \"+1555123456\",\n    \"email\": \"jane@example.com\",\n    \"address\": {\n      \"street\": \"456 Oak Avenue\",\n      \"city\": \"New York\",\n      \"state\": \"NY\",\n      \"zip\": \"10002\"\n    }\n  },\n  \"pickupAddress\": {\n    \"street\": \"123 Main Street\",\n    \"city\": \"New York\",\n    \"state\": \"NY\",\n    \"zip\": \"10001\"\n  },\n  \"deliveryAddress\": {\n    \"street\": \"456 Oak Avenue\",\n    \"city\": \"New York\",\n    \"state\": \"NY\",\n    \"zip\": \"10002\"\n  },\n  \"medicationNotes\": \"Keep refrigerated\",\n  \"driverInstructions\": \"Ring doorbell\",\n  \"codAmount\": 25.50\n}"
            },
            "url": "{{base_url}}/orders"
          }
        },
        {
          "name": "Get Order",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/orders/{{order_id}}"
          }
        },
        {
          "name": "Assign Driver",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"driverId\": \"{{driver_id}}\"\n}"
            },
            "url": "{{base_url}}/orders/{{order_id}}/assign-driver"
          }
        },
        {
          "name": "Update Status → picked_up",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{driver_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"picked_up\"\n}"
            },
            "url": "{{base_url}}/orders/{{order_id}}/status"
          }
        },
        {
          "name": "Update Status → on_the_way",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{driver_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"on_the_way\"\n}"
            },
            "url": "{{base_url}}/orders/{{order_id}}/status"
          }
        },
        {
          "name": "Update Status → failed",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{driver_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"failed\",\n  \"failedReason\": \"Patient not home\"\n}"
            },
            "url": "{{base_url}}/orders/{{order_id}}/status"
          }
        },
        {
          "name": "Submit Proof of Delivery",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{driver_token}}" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "image", "type": "file", "src": "" },
                { "key": "type", "value": "photo", "type": "text" },
                { "key": "signedBy", "value": "Jane Smith", "type": "text" },
                { "key": "latitude", "value": "40.7128", "type": "text" },
                { "key": "longitude", "value": "-74.0060", "type": "text" },
                { "key": "notes", "value": "Left at front door", "type": "text" }
              ]
            },
            "url": "{{base_url}}/orders/{{order_id}}/proof"
          }
        },
        {
          "name": "Get Proof of Delivery",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/orders/{{order_id}}/proof"
          }
        }
      ]
    },
    {
      "name": "Drivers",
      "item": [
        {
          "name": "List Drivers",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{base_url}}/drivers?isActive=true",
              "query": [{ "key": "isActive", "value": "true" }]
            }
          }
        },
        {
          "name": "Create Driver",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var res = pm.response.json();",
                  "if (res.data && res.data.driver) {",
                  "  pm.collectionVariables.set('driver_id', res.data.driver._id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Mike Driver\",\n  \"email\": \"mike@demopharmacy.com\",\n  \"phone\": \"+1555000999\",\n  \"vehicleType\": \"car\",\n  \"vehicleNumber\": \"NYC-9999\",\n  \"password\": \"Driver123!\"\n}"
            },
            "url": "{{base_url}}/drivers"
          }
        },
        {
          "name": "Get My Deliveries (Driver)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{driver_token}}" }],
            "url": "{{base_url}}/drivers/me/deliveries"
          }
        }
      ]
    },
    {
      "name": "Patients",
      "item": [
        {
          "name": "List Patients",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{base_url}}/patients",
              "query": [{ "key": "search", "value": "Jane", "disabled": true }]
            }
          }
        },
        {
          "name": "Create Patient",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Doe\",\n  \"phone\": \"+1555654321\",\n  \"email\": \"john@example.com\",\n  \"address\": {\n    \"street\": \"789 Pine Street\",\n    \"city\": \"New York\",\n    \"state\": \"NY\",\n    \"zip\": \"10003\"\n  }\n}"
            },
            "url": "{{base_url}}/patients"
          }
        }
      ]
    },
    {
      "name": "Reports",
      "item": [
        {
          "name": "Summary (today)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{base_url}}/reports/summary?range=today",
              "query": [{ "key": "range", "value": "today" }]
            }
          }
        },
        {
          "name": "Driver Performance (month)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{base_url}}/reports/driver-performance?range=month",
              "query": [{ "key": "range", "value": "month" }]
            }
          }
        }
      ]
    }
  ]
}
